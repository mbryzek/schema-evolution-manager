#!/usr/bin/env ruby
# Usage
#
#  sem-info command [arg1...]
#
#  sem-info tag exists 1.2.3
#    Returns true if the specified tag exists,
#    false otherwise
#
#  sem-info tag latest
#    Display the latest tag
#
#  sem-info version
#    Display the version of schema-evolution-manager
#
#  sem-info tag next [major|minor|micro]
#    Output information on the next tag. Defaults to micro
#    version increment from latest tag
#
#  sem-info db version --url <database url>
#    Display the latest recorded deployed schema version
#
#  sem-info db scripts --url <database url>
#    Display the applied script filenames
#
# Description
#
#   Utility script to pull information from the schema-evolution-manager
#   libraries. Initially designed to help with wrapper scripts that
#   needed information (like the next minor tag)
#
# Exit status
#
#   Errors go to stderr only, so stdout holds nothing but the answer.
#   1: the command failed (e.g. the database could not be read)
#   3: missing input (a command, subcommand, tag or connection)
#   4: invalid input (an unrecognized value or a malformed --url)
#

load File.join(File.dirname(__FILE__), 'sem-config')

command = ARGV.shift.to_s.strip

if command == "tag"
  puts SchemaEvolutionManager::SemInfo.tag(ARGV)

elsif command == "db"
  SchemaEvolutionManager::SemInfo.db(ARGV)

elsif command == "version"
  puts SchemaEvolutionManager::SemInfo.version(ARGV)

elsif command == ""
  SchemaEvolutionManager::RdocUsage.error!("Missing command", SchemaEvolutionManager::RdocUsage::MISSING_INPUT, :usage => true)

else
  SchemaEvolutionManager::RdocUsage.error!("Unrecognized command[%s]" % command, SchemaEvolutionManager::RdocUsage::INVALID_INPUT, :usage => true)
end
